@model JourneyViewModel

<div class="row">

    <div class="list-group">
        <div class="list-group-item list-group-item-action active text-center">
            <p class="mb-1 text-center">
                <a asp-controller="Home" asp-action="Index" class="text-white">
                    <svg width="2em" height="2em" viewBox="0 0 16 16" class="bi bi-arrow-left-short" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" d="M12 8a.5.5 0 0 1-.5.5H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5H11.5a.5.5 0 0 1 .5.5z" />
                    </svg>
                </a> 
                
                @Model.Origin - @Model.Destination
            </p>
            <small >@Model.DepartureDate.ToString("dd MMMM dddd")</small>
        </div>
        <div class="list-group-item ">
            <div >
                @foreach (var journey in Model.Journeys)
                {
                    <div class="card m-sm-3">
                        <blockquote class="blockquote mb-0 card-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <label>Kalkış</label>
                                </div>
                                <div class="col-md-1">
                                    <label></label>
                                </div>
                                <div class="col-md-3">
                                    <label>Varış</label>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <label>@journey.DepartureDate.ToString("HH:mm")</label>
                                </div>
                                <div class="col-md-1">
                                    <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-arrow-right-short" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8z" />
                                    </svg>
                                </div>
                                <div class="col-md-3">
                                    <label>@journey.ArrivalDate?.ToString("HH:mm")</label>
                                </div>
                                <div class="col-md-3">
                                    <span class="badge badge-danger">@journey.Price</span>
                                </div>
                            </div>
                            <p>
                                @journey.Origin - @journey.Destination
                            </p>
                        </blockquote>
                    </div>

                }
            </div>
        </div>
    
    </div>


</div>