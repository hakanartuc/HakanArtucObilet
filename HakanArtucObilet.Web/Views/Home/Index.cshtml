@model IndexViewModel


@section css{

    <link href="~/lib/selectpicker/css/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-datepicker3.standalone.min.css" rel="stylesheet" />

}

<div class="row">
    <form method="post">
        <div class="form-group">
            <label asp-for="OriginId">Nereden</label>
            <select class="form-control selectpicker with-ajax" data-live-search="true" asp-for="OriginId" asp-items="@ViewBag.BusLocations">
            </select>
        </div>
        <div class="form-group text-center">
            <a href="javascript:SwapLocations()">
                <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-arrow-down-up" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" d="M11.5 15a.5.5 0 0 0 .5-.5V2.707l3.146 3.147a.5.5 0 0 0 .708-.708l-4-4a.5.5 0 0 0-.708 0l-4 4a.5.5 0 1 0 .708.708L11 2.707V14.5a.5.5 0 0 0 .5.5zm-7-14a.5.5 0 0 1 .5.5v11.793l3.146-3.147a.5.5 0 0 1 .708.708l-4 4a.5.5 0 0 1-.708 0l-4-4a.5.5 0 0 1 .708-.708L4 13.293V1.5a.5.5 0 0 1 .5-.5z" />
                </svg>
            </a>

        </div>
        <div class="form-group">
            <label asp-for="DestinationId">Nereye</label>
            <select class="form-control selectpicker with-ajax" data-live-search="true" asp-for="DestinationId" asp-items="@ViewBag.BusLocations">
            </select>
        </div>
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label asp-for="DepartureDate">Tarih</label>
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="SetDateAfterToDay(0)">Bugün</button>
                </div>
            </div>
            <div class="row">
                <div class="col-md-8">
                    <input class="form-control datepicker" type="text" asp-for="DepartureDate" value="@Model.DepartureDate.ToString("dd.MM.yyyy")" />
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn btn-light btn-sm" onclick="SetDateAfterToDay(1)">Yarın</button>
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-primary col-md-12">Bilet Bul</button>
    </form>
</div>


@section Scripts{

    <script src="~/lib/selectpicker/js/bootstrap-select.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap-datepicker.min.js"></script>
    <script src="~/js/index.js"></script>

}